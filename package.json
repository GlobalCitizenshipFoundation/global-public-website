{
  "name": "monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "description": "Global Citizenship Foundation public website monorepo (Next.js + Sanity).",
  "homepage": "https://github.com/GlobalCitizenshipFoundation/global-public-website#readme",
  "bugs": {
    "url": "https://github.com/GlobalCitizenshipFoundation/global-public-website/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GlobalCitizenshipFoundation/global-public-website.git"
  },
  "contributors": [
    "Michał Szwindowski <hello@nedi.me>",
    "Dominik Dudek <example@email.to>"
  ],
  "scripts": {
    "check:routes": "tsx scripts/check-routes.ts",
    "dev": "concurrently -n web,cms -c auto --kill-others-on-fail \"npm run dev:web\" \"npm run dev:cms\"",
    "dev:web": "npm -w @gcf/web run dev",
    "dev:cms": "npm -w @gcf/cms run dev",
    "build": "npm run build:types && npm run build:web && npm run build:cms",
    "build:web": "npm -w @gcf/web run build",
    "build:cms": "npm -w @gcf/cms run build",
    "build:types": "npm -w @gcf/types run build",
    "typecheck:types": "npm -w @gcf/types run typecheck",
    "lint:web": "npm -w @gcf/web run lint",
    "lint:cms": "npm -w @gcf/cms run lint",
    "ci": "npm run typecheck && npm run lint && npm run build",
    "lint:web:ci": "npm -w @gcf/web run lint -- --max-warnings 0",
    "lint:cms:ci": "npm -w @gcf/cms run lint -- --max-warnings 0",
    "lint:fix": "eslint . --fix --cache --cache-location .cache/eslint",
    "lint": "npm run lint:web && npm run lint:cms",
    "typecheck:web": "npm -w @gcf/web run typecheck",
    "typecheck:cms": "npm -w @gcf/cms run typecheck",
    "typecheck": "npm run typecheck:types && npm run typecheck:web && npm run typecheck:cms",
    "test:web": "npm -w @gcf/web run test",
    "test:cms": "npm -w @gcf/cms run test",
    "test": "npm run test:web && npm run test:cms",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "precommit": "lint-staged -c lint-staged.config.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "15.5.9",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.5.9",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  }
}
