{
  "name": "monorepo",
  "private": true,
  "packageManager": "pnpm@10.29.1+sha512.48dae233635a645768a3028d19545cacc1688639eeb1f3734e42d6d6b971afbf22aa1ac9af52a173d9c3a20c15857cfa400f19994d79a2f626fcc73fccda9bbc",
  "pnpm": {
    "overrides": {
      "@types/node": "^24.2.1"
    }
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=10.29.1"
  },
  "description": "Global Citizenship Foundation public website monorepo (Next.js + Sanity).",
  "homepage": "https://github.com/GlobalCitizenshipFoundation/global-public-website#readme",
  "bugs": {
    "url": "https://github.com/GlobalCitizenshipFoundation/global-public-website/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GlobalCitizenshipFoundation/global-public-website.git"
  },
  "contributors": [
    "Michał Szwindowski <hello@nedi.me>",
    "Dominik Dudek <example@email.to>"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "concurrently -n web,cms -c auto --kill-others-on-fail \"pnpm -C apps/web dev\" \"pnpm -C apps/cms dev\"",
    "dev:web": "pnpm -C apps/web dev",
    "dev:cms": "pnpm -C apps/cms dev",
    "build": "pnpm -r --sort --filter \"./apps/**\" build",
    "typecheck": "pnpm -r --sort typecheck",
    "lint": "pnpm -r --sort lint",
    "lint:fix": "pnpm -r --sort lint:fix || true",
    "lint:web:ci": "pnpm -C apps/web lint:ci",
    "lint:cms:ci": "pnpm -C apps/cms lint:ci",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --write",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run build",
    "ci": "pnpm run check",
    "prepare": "husky",
    "precommit": "lint-staged -c lint-staged.config.mjs --concurrent false"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "20.19.33",
    "concurrently": "^9.2.1",
    "husky": "^9.1.6",
    "knip": "^5.83.1",
    "lint-staged": "^16.2.7",
    "typescript": "^5.8.0"
  }
}
