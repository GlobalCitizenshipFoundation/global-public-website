{
  "name": "@gcf/web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache --cache-location ../../.cache/eslint/web .",
    "lint:staged": "eslint --cache --cache-location ../../.cache/eslint/web --fix",
    "lint:fix": "eslint --fix --cache --cache-location ../../.cache/eslint/web",
    "lint:ci": "eslint . --cache --cache-location ../../.cache/eslint/web --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "stylelint": "stylelint \"src/**/*.{css,scss}\" --allow-empty-input",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --fix --allow-empty-input",
    "check:routes": "pnpm exec tsx scripts/check-routes.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run stylelint && pnpm run build"
  },
  "dependencies": {
    "@gcf/types": "workspace:*",
    "@portabletext/react": "^6.0.2",
    "@portabletext/types": "^4.0.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@sanity/client": "^7.6.0",
    "clsx": "^2.1.1",
    "next": "16.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "swiper": "^12.1.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@netlify/plugin-nextjs": "^5.12.0",
    "@next/eslint-plugin-next": "16.1.6",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.2.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.21.0",
    "eslint-config-next": "16.1.6",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "postcss": "^8.5.6",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.54.0"
  }
}
