{
  "name": "@gcf/web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "prebuild": "npm -w @gcf/types run build",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache --cache-location ../../.cache/eslint/web .",
    "lint:fix": "eslint --fix --cache --cache-location ../../.cache/eslint/web",
    "lint:ci": "eslint . --cache --cache-location ../../.cache/eslint/web --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "stylelint": "stylelint \"src/**/*.{css,scss}\" --allow-empty-input",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --fix --allow-empty-input",
    "check": "npm run lint && npm run typecheck && npm run stylelint && npm run build",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@gcf/types": "workspace:*",
    "@portabletext/react": "^3.2.1",
    "@sanity/client": "^7.6.0",
    "countries-list": "^3.1.1",
    "next": "15.5.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "swiper": "^11.2.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.12.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.6",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.1.18"
  }
}
