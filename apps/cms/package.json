{
  "name": "@gcf/cms",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy:graphql": "sanity graphql deploy",
    "lint": "biome check src",
    "lint:fix": "biome check src --write",
    "lint:ci": "biome check src",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:schema": "mkdirp ./.cache && sanity schema extract --path ./.cache/schema.json && rimraf ./.cache/schema.json",
    "check": "pnpm run lint:ci && pnpm run typecheck && pnpm run check:schema && pnpm run build"
  },
  "dependencies": {
    "@sanity/vision": "^5.9.0",
    "countries-list": "^3.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanity": "^5.9.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.0",
    "dotenv": "^17.2.4",
    "mkdirp": "^3.0.1",
    "rimraf": "^6.1.2"
  }
}
