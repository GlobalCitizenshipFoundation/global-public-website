{
  "$schema": "https://biomejs.dev/schemas/2.3.15/schema.json",
  "root": true,

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },

  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },

  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    "maxSize": 5242880,
    "includes": [
      "**",

      "!!**/node_modules",
      "!!**/.next",
      "!!**/dist",
      "!!**/.cache",
      "!!**/coverage",
      "!!**/.turbo",
      "!!**/.sanity"
    ]
  }
}
